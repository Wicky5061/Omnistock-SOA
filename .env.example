# ==============================================================================
# OmniStock Retail - Environment Configuration Template
# Copy this file to '.env' before running with Docker Compose:
#   cp .env.example .env
# ==============================================================================

# PostgreSQL Credentials
POSTGRES_USER=postgres
POSTGRES_PASSWORD=12345
POSTGRES_PORT=5432

# Service Database Names (auto-created via postgres-init/init.sql)
POSTGRES_PRODUCT_DB=product_db
POSTGRES_INVENTORY_DB=inventory_db
POSTGRES_ORDER_DB=order_db
POSTGRES_AUTH_DB=auth_db

# Service Host & Port Mapping
EUREKA_HOST=eureka-server
EUREKA_PORT=8761

FRONTEND_PORT=3000
GATEWAY_PORT=8080
EUREKA_SERVER_PORT=8761
PRODUCT_SERVICE_PORT=8081
INVENTORY_SERVICE_PORT=8082
ORDER_SERVICE_PORT=8083
AUTH_SERVICE_PORT=8084

# JWT Authentication
JWT_SECRET=OmniStockSecretKeyForJwtTokenValidationMustBeAtLeast256BitsLong!
JWT_EXPIRATION_MS=86400000
